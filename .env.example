# VidyaSetu Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.

# Application Environment
APP_ENV=development
APP_NAME=VidyaSetu
APP_VERSION=0.1.0-alpha
DEBUG=True

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Connection
# For PostgreSQL (Docker / Production / Local Postgres):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vidyasetu
# Fallback / Lightweight Development URL with SQLite (if Postgres is not running):
# DATABASE_URL=sqlite+aiosqlite:///./vidyasetu.db

# Synchronous Database URL (for Alembic migrations)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidyasetu
# SYNC_DATABASE_URL=sqlite:///./vidyasetu.db

# Security & Tokens (DEMO ONLY - Replace with high-entropy secret in production)
SECRET_KEY=vidyasetu-demo-secret-key-32-chars-minimum-token
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Structured Logging
LOG_LEVEL=INFO

# Simulation & Mock Configuration
# Note: External APIs (APAAR verification, AICTE Approval Portal) are simulated.
# All data generated/processed is synthetic demo data.
ENABLE_MOCK_APAAR=True
APAAR_MOCK_LATENCY_MS=250
AICTE_COUNCIL_REGISTRY_MOCK=True
